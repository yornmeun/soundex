APP_NAME="Soundex"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=soundex
DB_USERNAME=soundex
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Queue ---------------------------------------------------------------
# Must be larger than the ProcessGeneration job timeout (3600 s).
DB_QUEUE_RETRY_AFTER=3700

# --- HeyGen ----------------------------------------------------------------
# Recommended: leave HEYGEN_API_KEY empty and paste the key in the app under
# API Settings (it is stored encrypted). The .env value is used as a fallback.
HEYGEN_API_KEY=
HEYGEN_BASE_URL=https://api.heygen.com
# Optional. Normally the "kikitoons" voice is found by name in Voice Settings.
HEYGEN_DEFAULT_VOICE_ID=
HEYGEN_DEFAULT_VOICE_NAME=kikitoons
# heygen-voice-1 | heygen-voice-1-turbo | heygen-voice-1-turbo-free
HEYGEN_MODEL=heygen-voice-1
HEYGEN_REQUEST_TIMEOUT=300
HEYGEN_REQUESTS_PER_MINUTE=30
HEYGEN_MAX_ATTEMPTS=4

# --- Soundex ---------------------------------------------------------------
SOUNDEX_CHUNK_MAX_CHARS=3000
SOUNDEX_MAX_UPLOAD_KB=2048

# --- FFmpeg ----------------------------------------------------------------
# "ffmpeg" = system install on PATH; "bin/ffmpeg" = path relative to the project root
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFMPEG_TIMEOUT=1800
